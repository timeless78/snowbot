<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <io.snowbot.hub.ParticleView
            android:id="@+id/snowbot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/heard"
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/speech"
            style="@style/Speech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hello_line" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="32dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/status"
                style="@style/Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_offline" />

            <TextView
                android:id="@+id/device"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 봇 커넥트 규약: 짝 맺은 봇들 (이름 · 켜짐 · 몸 · 센서 · 받는 정보) -->
            <TextView
                android:id="@+id/bots"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bots_none" />

            <TextView
                android:id="@+id/car"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/car_unknown" />

            <!-- 근거 숫자: 스노봇이 수치를 말한 순간 몇 초 크게 보인다 -->
            <TextView
                android:id="@+id/flash"
                style="@style/Flash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- 차 상태 패널: 항목별 값 · 정상/주의 -->
            <TextView
                android:id="@+id/panel"
                style="@style/Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 짝 맺기: 토큰이 없을 때만. 주행 중에는 숨긴다 -->
            <LinearLayout
                android:id="@+id/pairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_help" />

                <EditText
                    android:id="@+id/device_id"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_device_hint"
                    android:inputType="textCapCharacters|textNoSuggestions" />

                <EditText
                    android:id="@+id/claim_code"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_claim_hint"
                    android:inputType="textCapCharacters|textNoSuggestions" />

                <Button
                    android:id="@+id/pair_button"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pair_button" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_talk"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/talk_start" />

                <!-- 시험용 버튼: 주행 중에는 숨긴다 (화면 조작 줄이기) -->
                <Button
                    android:id="@+id/btn_greet"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/act_greet" />

                <Button
                    android:id="@+id/btn_rest"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/act_rest" />

                <Button
                    android:id="@+id/btn_worry"
                    style="@style/Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/act_worry" />
            </LinearLayout>

            <Button
                android:id="@+id/voice_button"
                style="@style/Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_device" />

            <TextView
                android:id="@+id/air"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/air_unknown" />

            <Button
                android:id="@+id/add_bot_button"
                style="@style/Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_bot" />

            <Button
                android:id="@+id/unpair_button"
                style="@style/Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unpair" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
