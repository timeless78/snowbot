<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 말하기 버튼을 누른 동안만 듣는다. 차의 Pleos 음성 인식(차 안 엔진)이 글자로 바꾸고, 소리는 저장하지 않는다.
         Pleos 엔진을 못 쓰는 기기에서는 소리를 서버의 음성 인식으로만 보낸다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos 음성: 듣기(STT)·말하기(TTS). 보호 수준 normal 이라 설치하면 바로 허용된다 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos 차량 데이터 조회 (신청 불필요): 기어·트립 운전 시간 / 운전자 주의 경고등 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 말할 때 판단기 (신청 불필요): 방향지시등·전조등 / 와이퍼 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- 봇에 주는 차 정보: 내기 순환 (신청 불필요) -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <!-- 출발·하차 점검 (신청 불필요): 좌석 탑승·안전벨트 / 문·트렁크 / 주행 가능 거리는 CAR_DRIVE, 연료·EV 잔량 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 내비게이션 (NaviHelper, 신청 불필요): 목적지까지 남은 거리·시간·앞 정체 조회 / 경로 요청 / 주유소·충전소 화면 열기 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <!-- 경고등 목록(Safety.getTelltalesInfo · registerTelltales).
         Vehicle SDK 2.3.2 의 aar 는 이 셋에 PRIVATE_CAR_SAFETY 를 요구한다(@RequiresCustomPermission).
         Pleos 문서는 조회가 CAR_SAFETY 라고 적고 있어 서로 다르다. 에뮬레이터에서는 이 권한의 보호 수준이
         normal 이라 선언만으로 허용된다. 실차에서 막히면 경고등 통역만 쉬고(로그 한 번) 나머지는 그대로 돈다. -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <!-- 앱 화면을 닫아도 차 상태를 보고 출발·도착·안전 알림을 하는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnowBotHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 쓸 수 있는 화면(주의 분산 최적화). 주행 중에는 입력 칸을 숨긴다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <service
            android:name=".SnowBotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-car companion: watches vehicle state (gear, turn signal, driver attention warning) to speak at departure, arrival and safety warnings, and stays quiet while the driver is busy." />
        </service>
    </application>
</manifest>
