<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 말하기 버튼을 누른 동안만 녹음한다. 소리는 저장하지 않고 서버의 음성 인식으로만 보낸다 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos 차량 데이터 조회 (신청 불필요): 기어·트립 운전 시간 / 운전자 주의 경고등 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnowBotHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 쓸 수 있는 화면(주의 분산 최적화). 주행 중에는 입력 칸을 숨긴다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
